{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npx --yes npm@11.6.4 ci",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": [
    "iad1"
  ],
  "outputDirectory": ".next",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  }
}
