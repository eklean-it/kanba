{
  "name": "kanban-project-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postgres:setup": "node scripts/setup-postgres.js",
    "postgres:start": "docker-compose -f docker-compose.postgres.yml up -d",
    "postgres:stop": "docker-compose -f docker-compose.postgres.yml down",
    "postgres:reset": "docker-compose -f docker-compose.postgres.yml down -v && docker-compose -f docker-compose.postgres.yml up -d",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && next build --debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
